{
  "compilerOptions": {
    "module": "commonjs",
    "strict": true,
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "outDir": "dist",
    "rootDir": "cypress",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "types": ["cypress", "node"],
    "paths": {
      "@utils/*": ["./cypress/e2e/utils/*"],
      "@sharedTests/*": ["./cypress/e2e/utils/sharedTests/*"]
    }
  },
  "exclude": ["dist", "cypress.config.ts"],
  "include": ["cypress"]
}
